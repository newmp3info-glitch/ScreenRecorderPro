<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Screen Recorder Pro" android:textSize="28sp" android:textStyle="bold"/>
<TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Ready"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Resolution" android:textStyle="bold"/>
<Spinner android:id="@+id/resolution" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="FPS" android:textStyle="bold"/>
<Spinner android:id="@+id/fps" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<CheckBox android:id="@+id/mic" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Microphone" android:checked="true"/>
<CheckBox android:id="@+id/overlay" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Floating overlay controls" android:checked="true"/>
<Button android:id="@+id/start" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Start Recording"/>
<Button android:id="@+id/stop" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:enabled="false" android:text="Stop Recording"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Recordings are saved in Movies/ScreenRecorderPro. Internal audio capture is subject to Android and source-app restrictions." android:textSize="13sp"/>
</LinearLayout></ScrollView>
